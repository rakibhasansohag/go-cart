# Clerk authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard
CLERK_WEBHOOK_SIGNING_SECRET=

# Payment providers (use sandbox/test credentials for local development)
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLIC_KEY=
STRIPE_WEBHOOK_SECRET=

PAYPAL_CLIENT_ID=
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_API_BASE_URL=https://api-m.sandbox.paypal.com

# Marketplace settlement policy (USD ledger; verify payout-country support before launch)
GOCART_COMMISSION_PERCENT=2
GOCART_PAYOUT_COUNTRIES=US,BD,CA,GB,AU,SG

# Database
# Use the pooled URL for the application. For migrations, use Neon's direct
# connection URL temporarily if the pooled connection rejects schema commands.
DATABASE_URL=

# Application URL used to build safe links in transactional emails.
APP_URL=http://localhost:3000

# Runtime safety boundary for staging/E2E. Keep E2E_TEST_MODE=false unless all
# E2E_* values point to an isolated database, test auth instance, and sandbox providers.
APP_ENV=local
E2E_TEST_MODE=false
E2E_DATABASE_URL=
E2E_AUTH_MODE=test
E2E_PROVIDER_MODE=sandbox
E2E_PROTECTED=false
E2E_CUSTOMER_EMAIL=
E2E_SELLER_EMAIL=
E2E_ADMIN_EMAIL=

# Durable email outbox. Keep disabled until SMTP credentials are configured.
EMAIL_NOTIFICATIONS_ENABLED=false
EMAIL_OUTBOX_BATCH_SIZE=20
EMAIL_OUTBOX_MAX_ATTEMPTS=5

# Sends one reminder per unchanged saved checkout after the inactivity delay.
ABANDONED_CHECKOUT_EMAIL_ENABLED=false
ABANDONED_CHECKOUT_AFTER_HOURS=24
ABANDONED_CHECKOUT_BATCH_SIZE=25

# Use SMTP_PROVIDER=gmail with a Google App Password, or smtp with a host.
SMTP_PROVIDER=gmail
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_REQUIRE_TLS=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="GoCart <your-email@gmail.com>"

# Protects scheduled/manual recovery of pending and failed outbox jobs.
CRON_SECRET=
DEMO_FULFILLMENT_AUTOMATION_ENABLED=false
DEMO_FULFILLMENT_STEP_HOURS=24
DEMO_FULFILLMENT_BATCH_SIZE=100
