generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
  SELLER
}

model User {
  id      String @id @default(uuid())
  name    String
  email   String @unique
  picture String @db.Text
  role    Role   @default(USER)

  stores                     Store[]                     @relation("UserStores")
  following                  Store[]                     @relation("UserFollowingStore")
  reviews                    Review[]                    @relation("ReviewToUser")
  cart                       Cart?                       @relation("UserCart")
  shippingAddresses          ShippingAddress[]           @relation("UserShippingAddresses")
  orders                     Order[]                     @relation("UserOrders")
  wishlist                   Wishlist[]                  @relation("WishlistToUser")
  payments                   PaymentDetails[]            @relation("PaymentDetailsToUser")
  coupons                    Coupon[]                    @relation("CouponToUser")
  returnRequests             ReturnRequest[]             @relation("ReturnCustomer")
  returnEvidence             ReturnEvidence[]            @relation("ReturnEvidenceUploader")
  returnEvents               ReturnEvent[]               @relation("ReturnEventActor")
  fulfillmentEvents          FulfillmentTransition[]     @relation("FulfillmentTransitionActor")
  cancellationRequests       CancellationRequest[]       @relation("CancellationRequestCustomer")
  cancellationDecisions      CancellationRequest[]       @relation("CancellationRequestDecider")
  domainEvents               DomainEvent[]               @relation("DomainEventActor")
  notifications              Notification[]              @relation("NotificationRecipient")
  notificationPreferences    NotificationPreference[]    @relation("NotificationPreferenceUser")
  emailOutboxJobs            EmailOutbox[]               @relation("EmailOutboxRecipient")
  notificationDeliveryAudits NotificationDeliveryAudit[] @relation("NotificationDeliveryAuditRecipient")
  emailTemplatesEdited       EmailTemplate[]             @relation("EmailTemplateEditor")
  loyaltyAccount             LoyaltyAccount?
  personalCoupons            Coupon[]                    @relation("UserPersonalCoupons")
  dailyCheckIns              DailyCheckIn[]              @relation("UserDailyCheckIns")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model DailyCheckIn {
  id          String   @id @default(uuid())
  userId      String
  date        String // "YYYY-MM-DD"
  yearMonth   String // "YYYY-MM"
  dayIndex    Int // 1 to 31 (monthly check-in count)
  coinsEarned Int      @default(0)
  rewardType  String   @default("COINS") // "COINS" | "COINS_COUPON" | "FREE_SHIPPING"
  couponId    String?
  createdAt   DateTime @default(now())

  user User @relation("UserDailyCheckIns", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId, yearMonth])
}

model Coupon {
  id             String @id @default(uuid())
  code           String @unique
  startDate      String
  endDate        String
  discount       Int
  maxUses        Int    @default(0)
  maxUsesPerUser Int    @default(1)

  targetUserId String?
  targetUser   User?   @relation("UserPersonalCoupons", fields: [targetUserId], references: [id], onDelete: Cascade)

  storeId String?
  store   Store?  @relation("CouponToStore", fields: [storeId], references: [id], onDelete: Cascade)

  orders OrderGroup[] @relation("CouponToOrderGroup")
  users  User[]       @relation("CouponToUser")

  carts Cart[] @relation("CouponToCart")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([storeId])
  @@index([targetUserId])
}

model Category {
  id       String  @id @default(uuid())
  name     String
  image    String
  url      String  @unique
  featured Boolean @default(false)

  subCategories SubCategory[] @relation("CategoryToSubcategory")

  products Product[] @relation("CategoryToProduct")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SubCategory {
  id       String  @id @default(uuid())
  name     String
  image    String
  url      String  @unique
  featured Boolean @default(false)

  categoryId String
  category   Category @relation("CategoryToSubcategory", fields: [categoryId], references: [id])

  products Product[] @relation("SubCategoryToProduct")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId])
}

enum StoreStatus {
  PENDING
  ACTIVE
  BANNED
  DISABLED
}

model Store {
  id                                  String      @id @default(uuid())
  name                                String
  description                         String      @db.Text
  email                               String      @unique
  phone                               String
  url                                 String      @unique
  logo                                String
  cover                               String
  status                              StoreStatus @default(PENDING)
  averageRating                       Float       @default(0)
  numReviews                          Int         @default(0)
  featured                            Boolean     @default(false)
  returnPolicy                        String      @default("Return in 30 days.")
  returnsAccepted                     Boolean     @default(true)
  returnWindowDays                    Int         @default(30)
  returnShippingFees                  Boolean     @default(false)
  defaultShippingService              String      @default("International Delivery")
  defaultShippingFeePerItem           Float       @default(0)
  defaultShippingFeeForAdditionalItem Float       @default(0)
  defaultShippingFeePerKg             Float       @default(0)
  defaultShippingFeeFixed             Float       @default(0)
  defaultDeliveryTimeMin              Int         @default(7)
  defaultDeliveryTimeMax              Int         @default(31)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  userId String
  user   User   @relation("UserStores", fields: [userId], references: [id])

  products       Product[]       @relation("StoreToProduct")
  shippingRates  ShippingRate[]  @relation("StoreShippingRates")
  followers      User[]          @relation("UserFollowingStore")
  cartItems      CartItem[]      @relation("CartItemToStore")
  orderGroups    OrderGroup[]    @relation("OrderGroupToStore")
  coupons        Coupon[]        @relation("CouponToStore")
  returnRequests ReturnRequest[] @relation("ReturnRequestToStore")

  @@index([userId])
}

enum ShippingFeeMethod {
  ITEM
  WEIGHT
  FIXED
}

model Product {
  id                          String            @id @default(uuid())
  name                        String
  description                 String            @db.Text
  slug                        String            @unique
  brand                       String
  rating                      Float             @default(0)
  sales                       Int               @default(0)
  numReviews                  Int               @default(0)
  shippingFeeMethod           ShippingFeeMethod @default(ITEM)
  views                       Int               @default(0)
  freeShipping                FreeShipping?     @relation("ProductFreeShipping")
  freeShippingForAllCountries Boolean           @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  storeId String
  store   Store  @relation("StoreToProduct", fields: [storeId], references: [id])

  variants  ProductVariant[] @relation("ProductToProductVariant")
  specs     Spec[]           @relation("ProductSpec")
  questions Question[]       @relation("ProductQuestion")
  reviews   Review[]         @relation("ReviewToProduct")
  wishlist  Wishlist[]       @relation("WishlistToProduct")

  categoryId String
  category   Category @relation("CategoryToProduct", fields: [categoryId], references: [id])

  subCategoryId String
  subCategory   SubCategory @relation("SubCategoryToProduct", fields: [subCategoryId], references: [id])

  offerTagId String?
  offerTag   OfferTag? @relation("OfferTagToProduct", fields: [offerTagId], references: [id])

  @@index([storeId])
  @@index([categoryId])
  @@index([subCategoryId])
  @@index([offerTagId])
}

model ProductVariant {
  id                 String  @id @default(uuid())
  variantName        String  @db.Text
  variantDescription String? @db.Text
  variantImage       String
  slug               String  @unique
  isSale             Boolean @default(false)
  saleEndDate        String?
  sku                String
  keywords           String
  sales              Int     @default(0)
  weight             Float

  productId String
  product   Product @relation("ProductToProductVariant", fields: [productId], references: [id])

  sizes    Size[]                @relation("ProductVariantSizes")
  images   ProductVariantImage[] @relation("ProductVariantToVariantImage")
  colors   Color[]               @relation("ProductVariantColors")
  specs    Spec[]                @relation("ProductVariantSpec")
  wishlist Wishlist[]            @relation("WishlistToProductVariant")

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([productId])
}

model Size {
  id       String @id @default(uuid())
  size     String
  quantity Int
  price    Float
  discount Float  @default(0)

  wishlist Wishlist[] @relation("WishlistToSize")

  productVariantId String
  productVariant   ProductVariant @relation("ProductVariantSizes", fields: [productVariantId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([productVariantId])
}

model ProductVariantImage {
  id  String @id @default(uuid())
  url String
  alt String @default("")

  order Int?

  productVariantId String
  productVariant   ProductVariant @relation("ProductVariantToVariantImage", fields: [productVariantId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([productVariantId])
}

model Color {
  id   String @id @default(uuid())
  name String

  productVariantId String
  productVariant   ProductVariant @relation("ProductVariantColors", fields: [productVariantId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([productVariantId])
}

model OfferTag {
  id   String @id @default(uuid())
  name String
  url  String @unique

  products Product[] @relation("OfferTagToProduct")

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

model Spec {
  id    String @id @default(uuid())
  name  String
  value String

  productId String?
  product   Product? @relation("ProductSpec", fields: [productId], references: [id], onDelete: Cascade)

  variantId String?
  variant   ProductVariant? @relation("ProductVariantSpec", fields: [variantId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([productId])
  @@index([variantId])
}

model Question {
  id String @id @default(uuid())

  question String @db.Text
  answer   String @db.Text

  productId String
  product   Product @relation("ProductQuestion", fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([productId])
}

model Country {
  id   String @id @default(uuid())
  name String @unique
  code String @unique

  shippingRates         ShippingRate[]        @relation("CountryShippingRates")
  freeShippingCountries FreeShippingCountry[] @relation("FreeShippingToCountry")
  shippingAddresses     ShippingAddress[]     @relation("CountryToShippingAddress")

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

model ShippingRate {
  id String @id @default(uuid())

  shippingService              String
  shippingFeePerItem           Float
  shippingFeeForAdditionalItem Float
  shippingFeePerKg             Float
  shippingFeeFixed             Float
  deliveryTimeMin              Int
  deliveryTimeMax              Int
  returnPolicy                 String

  countryId String
  country   Country @relation("CountryShippingRates", fields: [countryId], references: [id])

  storeId String
  store   Store  @relation("StoreShippingRates", fields: [storeId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([countryId])
  @@index([storeId])
}

model FreeShipping {
  id        String  @id @default(uuid())
  productId String  @unique
  product   Product @relation("ProductFreeShipping", fields: [productId], references: [id], onDelete: Cascade)

  eligibaleCountries FreeShippingCountry[] @relation("FreeShippingCountries")

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

model FreeShippingCountry {
  id String @id @default(uuid())

  freeShippingId String
  freeShipping   FreeShipping @relation("FreeShippingCountries", fields: [freeShippingId], references: [id], onDelete: Cascade)

  countryId String
  country   Country @relation("FreeShippingToCountry", fields: [countryId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([freeShippingId])
  @@index([countryId])
}

model Review {
  id           String @id @default(uuid())
  variant      String
  variantImage String
  review       String
  rating       Float
  color        String
  size         String
  quantity     String
  likes        Int    @default(0)

  images ReviewImage[] @relation("ReviewToReviewImage")

  userId String
  user   User   @relation("ReviewToUser", fields: [userId], references: [id])

  productId String
  product   Product @relation("ReviewToProduct", fields: [productId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([userId])
  @@index([productId])
}

model ReviewImage {
  id  String @id @default(uuid())
  url String
  alt String @default("")

  reviewId String
  review   Review @relation("ReviewToReviewImage", fields: [reviewId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([reviewId])
}

model Cart {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation("UserCart", fields: [userId], references: [id], onDelete: Cascade)

  couponId String?
  coupon   Coupon? @relation("CouponToCart", fields: [couponId], references: [id])

  cartItems    CartItem[] @relation("CartToCartItem")
  shippingFees Float      @default(0)
  subTotal     Float
  total        Float

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([couponId])
}

model CartItem {
  id          String @id @default(uuid())
  productId   String
  variantId   String
  sizeId      String
  productSlug String
  variantSlug String
  sku         String
  name        String
  image       String
  size        String
  price       Float
  quantity    Int    @default(1)
  shippingFee Float  @default(0)
  totalPrice  Float

  cartId String
  cart   Cart   @relation("CartToCartItem", fields: [cartId], references: [id], onDelete: Cascade)

  storeId String
  store   Store  @relation("CartItemToStore", fields: [storeId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([cartId])
  @@index([storeId])
}

model ShippingAddress {
  id        String  @id @default(uuid())
  firstName String
  lastName  String
  phone     String
  address1  String
  address2  String?
  state     String
  city      String
  zip_code  String
  default   Boolean @default(false)

  orders Order[] @relation("ShippingAddressToOrder")

  userId String
  user   User   @relation("UserShippingAddresses", fields: [userId], references: [id])

  countryId String
  country   Country @relation("CountryToShippingAddress", fields: [countryId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([countryId])
  @@index([userId])
}

enum OrderStatus {
  Pending
  Confirmed
  Processing
  Shipped
  OutforDelivery
  Delivered
  Cancelled
  Failed
  Refunded
  Returned
  PartiallyShipped
  OnHold
  PickedUp
}

enum FulfillmentMode {
  PLATFORM
  SELLER
  PICKUP
}

enum PackageStatus {
  PENDING
  ACCEPTED
  PROCESSING
  READY_FOR_HANDOFF
  HANDED_OFF
  CANCELLED
}

enum ShipmentStatus {
  AWAITING_RECEIPT
  RECEIVED_AT_HUB
  READY_FOR_DISPATCH
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERY_ATTEMPT_FAILED
  READY_FOR_REDELIVERY
  RETURNED_TO_HUB
  RETURNED_TO_SELLER
  DELIVERED
  AWAITING_PICKUP
  PICKED_UP
  CANCELLED
}

enum FulfillmentEntityType {
  PACKAGE
  SHIPMENT
}

enum FulfillmentActorRole {
  CUSTOMER
  SELLER
  WAREHOUSE
  CARRIER
  ADMIN
  SYSTEM
}

enum FulfillmentSource {
  MANUAL
  API
  WEBHOOK
  AUTOMATION
  MIGRATION
}

enum FulfillmentAutomationMode {
  MANUAL
  DEMO
}

enum AutomationRunStatus {
  RUNNING
  SUCCEEDED
  PARTIAL
  FAILED
}

enum CancellationRequestStatus {
  REQUESTED
  APPROVED
  REJECTED
  WITHDRAWN
}

enum CancellationReasonCode {
  ORDERED_BY_MISTAKE
  FOUND_BETTER_PRICE
  SHIPPING_TOO_SLOW
  WRONG_ADDRESS
  WRONG_ITEM_OR_SIZE
  OTHER
}

enum PaymentStatus {
  Pending
  Paid
  Failed
  Declined
  Cancelled
  Refunded
  PartiallyRefunded
  Chargeback
}

enum PaymentMethod {
  Paypal
  Stripe
}

model Order {
  id           String @id @default(uuid())
  shippingFees Float
  subTotal     Float
  total        Float
  coinDiscount Float  @default(0)

  groups OrderGroup[] @relation("OrderGroupToOrder")

  orderStatus   OrderStatus   @default(Pending)
  paymentStatus PaymentStatus @default(Pending)

  paymentMethod        PaymentMethod?
  paymentDetails       PaymentDetails?         @relation("PaymentDetailsToOrder")
  paymentEvents        PaymentEvent[]          @relation("PaymentEventsToOrder")
  returnRequests       ReturnRequest[]         @relation("ReturnRequestToOrder")
  fulfillmentEvents    FulfillmentTransition[] @relation("FulfillmentTransitionToOrder")
  cancellationRequests CancellationRequest[]   @relation("CancellationRequestToOrder")
  loyaltyTransactions  LoyaltyTransaction[]    @relation("OrderLoyaltyTransactions")
  loyaltyRedemption    LoyaltyRedemption?      @relation("OrderLoyaltyRedemption")

  shippingAddressId String
  shippingAddress   ShippingAddress @relation("ShippingAddressToOrder", fields: [shippingAddressId], references: [id])

  userId String
  user   User   @relation("UserOrders", fields: [userId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([shippingAddressId])
  @@index([userId])
}

model OrderGroup {
  id               String                    @id @default(uuid())
  status           OrderStatus               @default(Pending)
  fulfillmentMode  FulfillmentMode           @default(PLATFORM)
  packageStatus    PackageStatus             @default(PENDING)
  automationMode   FulfillmentAutomationMode @default(MANUAL)
  nextTransitionAt DateTime?
  automationPaused Boolean                   @default(false)

  items OrderItem[] @relation("OrderItemToGroup")

  shippingService     String
  shippingDeliveryMin Int
  shippingDeliveryMax Int

  shippingFees Float
  subTotal     Float
  total        Float

  orderId String
  order   Order  @relation("OrderGroupToOrder", fields: [orderId], references: [id])

  storeId String
  store   Store  @relation("OrderGroupToStore", fields: [storeId], references: [id])

  couponId String?
  coupon   Coupon? @relation("CouponToOrderGroup", fields: [couponId], references: [id])

  returnRequests       ReturnRequest[]             @relation("ReturnRequestToOrderGroup")
  shipmentAssignments  ShipmentPackageAssignment[] @relation("OrderGroupToShipmentAssignments")
  fulfillmentEvents    FulfillmentTransition[]     @relation("FulfillmentTransitionToOrderGroup")
  cancellationRequests CancellationRequest[]       @relation("CancellationRequestToOrderGroup")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId])
  @@index([storeId])
  @@index([couponId])
  @@index([automationMode, automationPaused, nextTransitionAt])
}

enum ProductStatus {
  /// Product has been added to the order but no action taken yet
  Pending

  /// Product is being prepared (picked, packed, or manufactured)
  Processing

  /// Product is packed and ready for shipment
  ReadyForShipment

  /// Product has been shipped
  Shipped

  /// Product has been delivered to the customer
  Delivered

  /// Product order has been canceled
  Canceled

  /// Product has been returned by the customer
  Returned

  /// Product cost has been refunded
  Refunded

  /// Delivery attempt failed, product may return to warehouse
  FailedDelivery

  /// Product is on hold (e.g., stock issues, verification required)
  OnHold

  /// Product is delayed due to stock unavailability
  Backordered

  /// Some units of the product were shipped, but the order is not yet complete
  PartiallyShipped

  /// Customer requested an exchange for the product
  ExchangeRequested

  /// Product is awaiting customer pickup (for pickup orders)
  AwaitingPickup

  /// Customer pickup was completed and verified
  PickedUp
}

model OrderItem {
  id String @id @default(uuid())

  productId String
  variantId String
  sizeId    String

  productSlug String
  variantSlug String
  sku         String
  name        String
  image       String
  size        String
  quantity    Int    @default(1)
  shippingFee Float  @default(0)
  price       Float
  totalPrice  Float

  orderGroupId String
  orderGroup   OrderGroup @relation("OrderItemToGroup", fields: [orderGroupId], references: [id], onDelete: Cascade)

  status      ProductStatus @default(Pending)
  deliveredAt DateTime?

  returnItems   ReturnItem[]   @relation("ReturnItemToOrderItem")
  shipmentItems ShipmentItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderGroupId])
  @@index([status, deliveredAt])
}

model Shipment {
  id     String         @id @default(uuid())
  status ShipmentStatus @default(AWAITING_RECEIPT)

  carrier             String?
  trackingNumber      String?
  serviceLevel        String?
  estimatedDeliveryAt DateTime?
  proofOfDeliveryUrl  String?   @db.Text
  proofOfDeliveryAt   DateTime?

  failureReasonCode String?
  failureMessage    String? @db.Text

  fulfillmentEvents  FulfillmentTransition[]     @relation("FulfillmentTransitionToShipment")
  items              ShipmentItem[]
  trackingEvents     TrackingEvent[]
  deliveryAttempts   DeliveryAttempt[]
  packageAssignments ShipmentPackageAssignment[] @relation("ShipmentToPackageAssignments")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([carrier, trackingNumber])
}

/// A shipment may carry one or more seller packages, and a package may be
/// split across multiple shipments. Item quantities remain authoritative in
/// ShipmentItem so partial shipment assignment is explicit and auditable.
model ShipmentPackageAssignment {
  id           String   @id @default(uuid())
  shipmentId   String
  orderGroupId String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  shipment   Shipment   @relation("ShipmentToPackageAssignments", fields: [shipmentId], references: [id], onDelete: Cascade)
  orderGroup OrderGroup @relation("OrderGroupToShipmentAssignments", fields: [orderGroupId], references: [id], onDelete: Cascade)

  @@unique([shipmentId, orderGroupId])
  @@index([orderGroupId])
}

model ShipmentItem {
  id          String   @id @default(uuid())
  shipmentId  String
  orderItemId String
  quantity    Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  shipment  Shipment  @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Restrict)

  @@unique([shipmentId, orderItemId])
  @@index([orderItemId])
}

model TrackingEvent {
  id              String         @id @default(uuid())
  shipmentId      String
  providerEventId String?        @unique
  status          ShipmentStatus
  location        String?
  description     String?        @db.Text
  occurredAt      DateTime
  createdAt       DateTime       @default(now())

  shipment Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@index([shipmentId, occurredAt])
}

model DeliveryAttempt {
  id            String   @id @default(uuid())
  shipmentId    String
  attemptNumber Int
  outcome       String
  reasonCode    String?
  message       String?  @db.Text
  occurredAt    DateTime @default(now())

  shipment Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@unique([shipmentId, attemptNumber])
  @@index([shipmentId, occurredAt])
}

model FulfillmentTransition {
  id             String                @id @default(uuid())
  entityType     FulfillmentEntityType
  previousStatus String
  nextStatus     String
  actorRole      FulfillmentActorRole
  source         FulfillmentSource     @default(MANUAL)
  reasonCode     String?
  message        String?               @db.Text
  idempotencyKey String                @unique

  actorUserId String?
  actorUser   User?   @relation("FulfillmentTransitionActor", fields: [actorUserId], references: [id])

  orderId String
  order   Order  @relation("FulfillmentTransitionToOrder", fields: [orderId], references: [id], onDelete: Cascade)

  orderGroupId String
  orderGroup   OrderGroup @relation("FulfillmentTransitionToOrderGroup", fields: [orderGroupId], references: [id], onDelete: Cascade)

  shipmentId String?
  shipment   Shipment? @relation("FulfillmentTransitionToShipment", fields: [shipmentId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([orderId, createdAt])
  @@index([orderGroupId, createdAt])
  @@index([shipmentId, createdAt])
  @@index([actorUserId])
}

model AutomationRun {
  id             String              @id @default(uuid())
  status         AutomationRunStatus @default(RUNNING)
  startedAt      DateTime            @default(now())
  finishedAt     DateTime?
  scannedCount   Int                 @default(0)
  advancedCount  Int                 @default(0)
  skippedCount   Int                 @default(0)
  failedCount    Int                 @default(0)
  errorSummary   String?             @db.Text
  idempotencyKey String              @unique

  @@index([status, startedAt])
}

enum NotificationCategory {
  ORDER
  PAYMENT
  FULFILLMENT
  DELIVERY
  CANCELLATION
  RETURN
  REFUND
  SYSTEM
}

enum NotificationChannel {
  IN_APP
  EMAIL
}

enum NotificationDeliveryStatus {
  QUEUED
  PROCESSING
  SENT
  FAILED
  SKIPPED
}

model NotificationPreference {
  id        String               @id @default(uuid())
  category  NotificationCategory
  channel   NotificationChannel
  enabled   Boolean              @default(true)
  userId    String
  user      User                 @relation("NotificationPreferenceUser", fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  @@unique([userId, category, channel])
  @@index([userId, channel, enabled])
}

enum EmailOutboxStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
  CANCELLED
}

enum EmailTemplateSource {
  DEFAULT
  CUSTOM
}

model DomainEvent {
  id            String @id @default(uuid())
  eventKey      String @unique
  eventType     String
  aggregateType String
  aggregateId   String
  payload       Json

  actorUserId String?
  actorUser   User?   @relation("DomainEventActor", fields: [actorUserId], references: [id])

  notifications  Notification[]
  emailOutbox    EmailOutbox[]
  deliveryAudits NotificationDeliveryAudit[]

  createdAt DateTime @default(now())

  @@index([eventType, createdAt])
  @@index([aggregateType, aggregateId, createdAt])
  @@index([actorUserId])
}

model Notification {
  id        String               @id @default(uuid())
  category  NotificationCategory
  eventType String
  title     String
  message   String               @db.Text
  actionUrl String?
  readAt    DateTime?

  sourceEventId String
  sourceEvent   DomainEvent @relation(fields: [sourceEventId], references: [id], onDelete: Cascade)

  recipientId String
  recipient   User   @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([sourceEventId, recipientId])
  @@index([recipientId, readAt, createdAt])
  @@index([recipientId, category, createdAt])
}

/// Immutable per-attempt operational record for notification delivery. DomainEvent
/// remains the business audit; this table records queue and provider outcomes.
model NotificationDeliveryAudit {
  id             String                     @id @default(uuid())
  channel        NotificationChannel
  status         NotificationDeliveryStatus
  attemptNumber  Int                        @default(0)
  recipientEmail String?
  error          String?                    @db.Text
  startedAt      DateTime                   @default(now())
  finishedAt     DateTime?

  sourceEventId String
  sourceEvent   DomainEvent @relation(fields: [sourceEventId], references: [id], onDelete: Cascade)
  recipientId   String
  recipient     User        @relation("NotificationDeliveryAuditRecipient", fields: [recipientId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([sourceEventId, recipientId, channel, attemptNumber])
  @@index([status, createdAt])
  @@index([recipientId, createdAt])
  @@index([sourceEventId, channel, attemptNumber])
}

model EmailOutbox {
  id              String              @id @default(uuid())
  templateKey     String
  recipientEmail  String
  payload         Json
  status          EmailOutboxStatus   @default(PENDING)
  attemptCount    Int                 @default(0)
  nextAttemptAt   DateTime            @default(now())
  lastAttemptAt   DateTime?
  sentAt          DateTime?
  lastError       String?             @db.Text
  templateSource  EmailTemplateSource @default(DEFAULT)
  templateVersion Int                 @default(0)

  sourceEventId String
  sourceEvent   DomainEvent @relation(fields: [sourceEventId], references: [id], onDelete: Cascade)

  recipientId String
  recipient   User   @relation("EmailOutboxRecipient", fields: [recipientId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([sourceEventId, recipientId])
  @@index([status, nextAttemptAt])
  @@index([recipientId, createdAt])
}

model EmailTemplate {
  id             String  @id @default(uuid())
  templateKey    String  @unique
  draftSubject   String
  draftPreheader String  @db.Text
  draftBodyHtml  String  @db.Text
  draftCtaLabel  String?
  draftEnabled   Boolean @default(true)

  publishedSubject   String?
  publishedPreheader String?   @db.Text
  publishedBodyHtml  String?   @db.Text
  publishedCtaLabel  String?
  publishedEnabled   Boolean?
  publishedVersion   Int       @default(0)
  publishedAt        DateTime?

  updatedById String?
  updatedBy   User?   @relation("EmailTemplateEditor", fields: [updatedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([updatedById])
  @@index([publishedAt])
}

model CancellationRequest {
  id           String                    @id @default(uuid())
  status       CancellationRequestStatus @default(REQUESTED)
  reasonCode   CancellationReasonCode
  message      String?                   @db.Text
  decisionNote String?                   @db.Text

  customerId String
  customer   User   @relation("CancellationRequestCustomer", fields: [customerId], references: [id])

  decidedById String?
  decidedBy   User?   @relation("CancellationRequestDecider", fields: [decidedById], references: [id])

  orderId String
  order   Order  @relation("CancellationRequestToOrder", fields: [orderId], references: [id], onDelete: Cascade)

  orderGroupId String
  orderGroup   OrderGroup @relation("CancellationRequestToOrderGroup", fields: [orderGroupId], references: [id], onDelete: Cascade)

  decidedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([customerId, status])
  @@index([orderGroupId, status])
  @@index([orderId])
  @@index([decidedById])
}

model Wishlist {
  id String @id @default(uuid())

  userId String
  user   User   @relation("WishlistToUser", fields: [userId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation("WishlistToProduct", fields: [productId], references: [id], onDelete: Cascade)

  variantId String
  variant   ProductVariant @relation("WishlistToProductVariant", fields: [variantId], references: [id], onDelete: Cascade)

  sizeId String?
  size   Size?   @relation("WishlistToSize", fields: [sizeId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([productId])
  @@index([variantId])
  @@index([sizeId])
}

model PaymentDetails {
  id String @id @default(uuid())

  paymentInetntId   String  @unique
  providerCaptureId String? @unique
  paymentMethod     String
  status            String
  amount            Float
  currency          String

  orderId String @unique
  order   Order  @relation("PaymentDetailsToOrder", fields: [orderId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation("PaymentDetailsToUser", fields: [userId], references: [id], onDelete: Cascade)

  returnRequests     ReturnRequest[]     @relation("ReturnRequestToPayment")
  refundTransactions RefundTransaction[] @relation("RefundTransactionToPayment")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId])
  @@index([userId])
}

model PaymentEvent {
  id String @id @default(uuid())

  provider          PaymentMethod
  providerEventId   String        @unique
  providerPaymentId String?
  eventType         String
  status            String
  amount            Float?
  currency          String?
  metadata          Json?

  orderId String
  order   Order  @relation("PaymentEventsToOrder", fields: [orderId], references: [id], onDelete: Cascade)

  processedAt DateTime @default(now())
  createdAt   DateTime @default(now())

  @@index([orderId])
  @@index([provider, providerPaymentId])
  @@index([eventType])
}

enum ReturnRequestStatus {
  REQUESTED
  UNDER_REVIEW
  MORE_INFO_REQUIRED
  APPROVED
  REJECTED
  AWAITING_SHIPMENT
  IN_TRANSIT
  RECEIVED
  REFUND_PENDING
  REFUNDED
  EXCHANGE_PENDING
  EXCHANGED
  CANCELLED
  ESCALATED
  CLOSED
}

enum ReturnReason {
  DAMAGED
  DEFECTIVE
  WRONG_ITEM
  NOT_AS_DESCRIBED
  SIZE_OR_FIT
  CHANGED_MIND
  ARRIVED_LATE
  MISSING_PARTS
  OTHER
}

enum ReturnResolution {
  REFUND
  EXCHANGE
}

enum ReturnActorRole {
  CUSTOMER
  SELLER
  ADMIN
  SYSTEM
}

enum ReturnEvidenceType {
  IMAGE
  VIDEO
  DOCUMENT
}

enum RefundTransactionStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
  CANCELLED
}

model ReturnRequest {
  id         String              @id @default(uuid())
  status     ReturnRequestStatus @default(REQUESTED)
  reason     ReturnReason
  resolution ReturnResolution

  customerNote String? @db.Text
  sellerNote   String? @db.Text
  adminNote    String? @db.Text

  requestedAmount   Float
  requestedSubtotal Float  @default(0)
  requestedShipping Float  @default(0)
  requestedDiscount Float  @default(0)
  requestedTax      Float  @default(0)
  approvedAmount    Float?
  currency          String @default("USD")

  respondBy   DateTime?
  returnBy    DateTime?
  escalatedAt DateTime?
  resolvedAt  DateTime?
  closedAt    DateTime?

  customerId String
  customer   User   @relation("ReturnCustomer", fields: [customerId], references: [id])

  orderId String
  order   Order  @relation("ReturnRequestToOrder", fields: [orderId], references: [id], onDelete: Cascade)

  orderGroupId String
  orderGroup   OrderGroup @relation("ReturnRequestToOrderGroup", fields: [orderGroupId], references: [id])

  storeId String
  store   Store  @relation("ReturnRequestToStore", fields: [storeId], references: [id])

  paymentDetailsId String?
  paymentDetails   PaymentDetails? @relation("ReturnRequestToPayment", fields: [paymentDetailsId], references: [id])

  items        ReturnItem[]
  evidence     ReturnEvidence[]
  events       ReturnEvent[]
  transactions RefundTransaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId, status])
  @@index([storeId, status])
  @@index([orderId])
  @@index([orderGroupId])
  @@index([paymentDetailsId])
  @@index([createdAt])
}

model ReturnItem {
  id String @id @default(uuid())

  quantity          Int
  receivedQuantity  Int      @default(0)
  restockedQuantity Int      @default(0)
  unitAmount        Float
  shippingAmount    Float    @default(0)
  discountAmount    Float    @default(0)
  taxAmount         Float    @default(0)
  requestedAmount   Float
  approvedAmount    Float?
  restockable       Boolean?

  // Set while a request is active and clear on terminal states. This prevents
  // overlapping active requests for the same order item.
  activeRequestKey String? @unique

  returnRequestId String
  returnRequest   ReturnRequest @relation(fields: [returnRequestId], references: [id], onDelete: Cascade)

  orderItemId String
  orderItem   OrderItem @relation("ReturnItemToOrderItem", fields: [orderItemId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([returnRequestId, orderItemId])
  @@index([orderItemId])
}

model ReturnEvidence {
  id   String             @id @default(uuid())
  type ReturnEvidenceType
  url  String             @db.Text
  alt  String             @default("")

  returnRequestId String
  returnRequest   ReturnRequest @relation(fields: [returnRequestId], references: [id], onDelete: Cascade)

  uploadedById String?
  uploadedBy   User?   @relation("ReturnEvidenceUploader", fields: [uploadedById], references: [id])

  createdAt DateTime @default(now())

  @@index([returnRequestId])
  @@index([uploadedById])
}

model ReturnEvent {
  id         String               @id @default(uuid())
  actorRole  ReturnActorRole
  eventType  String
  fromStatus ReturnRequestStatus?
  toStatus   ReturnRequestStatus?
  note       String?              @db.Text
  metadata   Json?

  returnRequestId String
  returnRequest   ReturnRequest @relation(fields: [returnRequestId], references: [id], onDelete: Cascade)

  actorId String?
  actor   User?   @relation("ReturnEventActor", fields: [actorId], references: [id])

  createdAt DateTime @default(now())

  @@index([returnRequestId, createdAt])
  @@index([actorId])
  @@index([eventType])
}

model RefundTransaction {
  id               String                  @id @default(uuid())
  provider         PaymentMethod
  providerRefundId String?                 @unique
  idempotencyKey   String                  @unique
  status           RefundTransactionStatus @default(PENDING)
  amount           Float
  currency         String
  failureReason    String?                 @db.Text
  providerResponse Json?
  processedAt      DateTime?

  returnRequestId String
  returnRequest   ReturnRequest @relation(fields: [returnRequestId], references: [id], onDelete: Cascade)

  paymentDetailsId String
  paymentDetails   PaymentDetails @relation("RefundTransactionToPayment", fields: [paymentDetailsId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([returnRequestId])
  @@index([paymentDetailsId])
  @@index([provider, status])
}

enum LoyaltyTxType {
  EARN
  REDEEM
}

model LoyaltyAccount {
  id             String   @id @default(uuid())
  userId         String   @unique
  balance        Int      @default(0)
  lifetimeEarned Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions LoyaltyTransaction[]
  redemptions  LoyaltyRedemption[]
}

model LoyaltyTransaction {
  id             String        @id @default(uuid())
  accountId      String
  orderId        String?
  type           LoyaltyTxType
  points         Int
  idempotencyKey String        @unique
  note           String?
  createdAt      DateTime      @default(now())

  account LoyaltyAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  order   Order?         @relation("OrderLoyaltyTransactions", fields: [orderId], references: [id])

  @@index([accountId])
  @@index([orderId])
}

model LoyaltyRedemption {
  id        String   @id @default(uuid())
  accountId String
  orderId   String   @unique
  points    Int
  discount  Decimal  @db.Decimal(10, 2)
  createdAt DateTime @default(now())

  account LoyaltyAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  order   Order          @relation("OrderLoyaltyRedemption", fields: [orderId], references: [id])

  @@index([accountId])
}
