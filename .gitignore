# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/playwright-report
/test-results

# next.js
/.next/
/out/

# production
/build
.env*
!.env.example

# misc
.DS_Store
*.pem
.env.staging.local

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

old_code

# graphify-out — only keep the report, graph.json, and wiki for reference
# Ignore everything by default, then opt-in the files we want
graphify-out/
!graphify-out/GRAPH_REPORT.md
!graphify-out/graph.json
!graphify-out/wiki/
!graphify-out/wiki/**

# graphify internal build artifacts (never commit)
graphify-out/.graphify_*
graphify-out/graph.html
graphify-out/obsidian/
graphify-out/GRAPH_TREE.html
graphify-out/cypher.txt
graphify-out/graph.svg
graphify-out/graph.graphml
graphify-out/merged-graph.json

# SQL backup dumps (large, binary-like — use Neon for data)
backup.sql
gocart_backup.sql

# scratch files
scratch-test-mysql.ts
migrate-to-neon.ts

/docs

.next-e2e
