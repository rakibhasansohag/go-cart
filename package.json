		"@types/react-tag-input": "^6.6.6",
		"@vercel/analytics": "^1.5.0",
		"@vercel/functions": "^2.2.13",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"cmdk": "^1.1.1",
		"colorthief": "^2.7.0",
		"cookies-next": "^6.1.1",
		"date-fns": "^4.4.0",
		"dompurify": "^3.4.15",
		"embla-carousel-react": "^8.6.0",
		"flag-icons": "^7.5.0",
		"framer-motion": "^12.42.2",
		"input-otp": "^1.5.0",
		"jodit-react": "^5.5.8",
		"lucide-react": "^0.525.0",
		"mjml": "4.18.0",
