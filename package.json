		"react-rating-stars-component": "^2.2.0",
		"react-resizable-panels": "^3.0.6",
		"react-responsive": "^10.0.1",
		"react-spinners": "^0.17.1",
		"react-tag-input": "6.9.0",
		"recharts": "2.15.4",
		"sanitize-html": "^2.17.7",
