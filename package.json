{
	"name": "go-cart",
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"dev": "bun run db:prepare && next dev --webpack",
		"dev:turbo": "bun run db:prepare && next dev",
		"dev:fresh": "bun run clean:next && bun dev",
		"clean:next": "bun -e \"require('fs').rmSync('.next',{recursive:true,force:true})\"",
		"db:prepare": "bun --no-env-file x prisma generate && bun --no-env-file x prisma migrate deploy",
		"db:anonymize-staging": "bun prisma/anonymize-staging.ts",
		"db:sync-e2e-users": "bun prisma/sync-e2e-users.ts",
		"db:seed:demo": "bun prisma/seed-demo.ts",
		"db:seed:products": "bun prisma/seed-products.ts",
		"db:seed:centralized": "bun prisma/seed-centralized-catalog.ts",
		"db:clean:prod": "bun prisma/cleanup-production.ts",

		"db:e2e:up": "bun --no-env-file scripts/e2e-local.ts up",
		"db:e2e:prepare": "bun --no-env-file scripts/e2e-local.ts prepare",
		"db:e2e:sync-users": "bun --no-env-file scripts/e2e-local.ts sync-users",
		"test:integration:local": "bun --no-env-file scripts/e2e-local.ts integration",
		"test:stripe:refund:local": "bun --no-env-file scripts/e2e-local.ts stripe-refund",
		"test:stripe:payout:local": "bun --no-env-file scripts/e2e-local.ts stripe-payout",
		"test:stripe:browser-refund:local": "bun --no-env-file scripts/e2e-local.ts stripe-browser-refund",
		"test:stripe:browser-payout:local": "bun --no-env-file scripts/e2e-local.ts stripe-browser-payout",
		"test:paypal:auth:local": "bun --no-env-file scripts/e2e-local.ts paypal-auth",
		"build:e2e": "bun --no-env-file scripts/e2e-local.ts build:e2e",
		"db:e2e:reset": "bun --no-env-file scripts/e2e-local.ts reset",
		"db:e2e:down": "bun --no-env-file scripts/e2e-local.ts down",
		"test:e2e:local": "bun --no-env-file scripts/e2e-local.ts test",
		"test:load:local": "bun --no-env-file scripts/phase15-load-smoke.ts",
		"test:rate-limit:local": "bun --no-env-file scripts/e2e-local.ts rate-limit",
		"test:restore:local": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/phase15-restore-drill.ps1",
		"build": "bun prisma generate && next build",
		"start": "next start",
		"lint": "eslint .",
		"check:format": "git diff --check",
		"test": "vitest run",
		"test:unit": "vitest run",
		"test:e2e": "playwright test",
		"test:e2e:protected": "playwright test --project=protected-chromium",
		"test:payment": "vitest run src/lib/payments",
		"test:watch": "vitest",
		"typecheck": "tsc --noEmit --incremental false",
		"stripe:listen": "stripe listen --events payment_intent.succeeded,payment_intent.payment_failed,payment_intent.canceled,charge.refunded,transfer.created,transfer.updated,transfer.reversed,account.updated,payout.paid,payout.failed,payout.canceled --forward-to http://localhost:3000/api/webhooks/stripe",
		"postinstall": "bun prisma generate"
	},
	"dependencies": {
		"@clerk/nextjs": "^6.39.6",
		"@google/genai": "^1.52.0",
		"@google/generative-ai": "^0.24.1",
		"@hookform/resolvers": "^5.9.1",
