		"zustand": "^5.0.15"
	},
	"devDependencies": {
		"@clerk/backend": "^3.17.2",
		"@clerk/testing": "^2.2.34",
		"@eslint/eslintrc": "^3",
		"@playwright/test": "^1.63.0",
		"@tailwindcss/postcss": "^4.3.3",
		"@tanstack/react-query-devtools": "^5.102.8",
		"@types/mjml": "4.7.4",
		"@types/node": "^20.19.43",
